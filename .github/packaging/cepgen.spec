# RPM spec for CepGen, meant to be built on COPR (see .github/scripts/copr-custom).
#
# The "Version:" and "Release:" lines below are rewritten by .github/scripts/copr-custom from the
# git tag being built, so there is nothing to bump here for a new release.
#
# Optional add-ons (ROOT, Pythia8, HepMC3, LHAPDF, ...) are picked up automatically by CMake
# if their -devel package is installed at build time. Add the matching BuildRequires lines
# below to enable them (and check that the add-on libraries land in the file list).

%bcond_with tests

Name:           cepgen
Version:        1.3.1
Release:        1%{?dist}
Summary:        Generic central exclusive processes event generator

License:        GPL-3.0-or-later
URL:            https://cepgen.hepforge.org
# generated by .github/scripts/copr-custom (git archive of the tagged commit)
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  cmake >= 3.20
BuildRequires:  gcc-c++
BuildRequires:  gcc-gfortran
BuildRequires:  make
BuildRequires:  gsl-devel
BuildRequires:  python3-devel
BuildRequires:  pybind11-devel
BuildRequires:  boost-devel
# add-ons: picked up automatically by CMake when their -devel package is present, and shipped as sub-packages
BuildRequires:  lhapdf-devel
BuildRequires:  HepMC3-devel
BuildRequires:  pythia-devel
BuildRequires:  cmake(ROOT)
BuildRequires:  root-hist
BuildRequires:  root-mathcore
BuildRequires:  root-foam

%description
CepGen is a generic central exclusive processes event generator. It provides a
modular framework to compute cross sections and to generate events for
photon-induced and other central exclusive processes in hadron and lepton
colliders.

%package        devel
Summary:        Development files for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    devel
Headers and CMake find module needed to build programs and plugins against
the CepGen libraries.

%package        lhapdf
Summary:        LHAPDF wrappers for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    lhapdf
CepGen add-on library interfacing the LHAPDF parton distribution functions.

%package        hepmc3
Summary:        HepMC3 output wrappers for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    hepmc3
CepGen add-on library to export events in the HepMC3 format.

%package        root
Summary:        ROOT wrappers for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    root
CepGen add-on library to export events and histograms through ROOT.

%package        pythia8
Summary:        Pythia 8 hadronisation wrappers for %{name}
Requires:       %{name}%{?_isa} = %{version}-%{release}

%description    pythia8
CepGen add-on library interfacing the Pythia 8 hadronisation and decay engine.

# CepGen ships its modules as unversioned shared objects loaded at runtime:
# keep them in the main package, not in -devel.
# TODO: drop this once the file lists below have been confirmed on a first COPR build.
%global _unpackaged_files_terminate_build 0

%prep
%autosetup -n %{name}-%{version}

%build
# CMAKE_BUILD_TYPE must be explicit: the project only selects its optimised flags for "Release".
# CEPGEN_VERSION_OVERRIDE replaces the "git describe" lookup, which cannot work from a tarball.
# CMAKE_Fortran_FLAGS must be explicit too: the project sets it before enabling Fortran, which hides the FFLAGS
# environment variable. Without Fedora's flags (-fPIE through the hardening specs) the Fortran check fails to
# link against the hardened (-pie) LDFLAGS.
%cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_Fortran_FLAGS="%{build_fflags}" \
    -DCEPGEN_VERSION_OVERRIDE=%{version} \
    -DCMAKE_BUILD_UTILS=ON \
    -DCMAKE_BUILD_TESTS=%{?with_tests:ON}%{!?with_tests:OFF}
%cmake_build

%install
%cmake_install

%if %{with tests}
%check
export CEPGEN_PATH=%{_builddir}/%{name}-%{version}
%ctest -- -LE "unstable" -E "benchmark_|validation_"
%endif

%files
%license LICENSE
%doc README.md CHANGELOG
%{_bindir}/*
%{_libdir}/*.so
%exclude %{_libdir}/libCepGenLHAPDF.so
%exclude %{_libdir}/libCepGenHepMC3.so
%exclude %{_libdir}/libCepGenPythia8.so
%exclude %{_libdir}/libCepGenRoot.so
%{_datadir}/CepGen/

%files lhapdf
%{_libdir}/libCepGenLHAPDF.so

%files hepmc3
%{_libdir}/libCepGenHepMC3.so

%files pythia8
%{_libdir}/libCepGenPythia8.so

%files root
%{_libdir}/libCepGenRoot.so

%files devel
%{_includedir}/CepGen*/
%{_datadir}/cmake/FindCepGen.cmake

