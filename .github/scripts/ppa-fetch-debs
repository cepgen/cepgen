#!/usr/bin/env python3
"""Wait for the Launchpad PPA builds of a CepGen release and download the resulting .deb files.

  ppa-fetch-debs <ppa> <tag> <output-dir> "<series> [<series> ...]" [<ppa-revision>]

<ppa> is the dput target ("ppa:owner/name"). Matches the version scheme of ppa-source, i.e.
<version>-0ppa<rev>~<series>1. Anonymous access is enough for a public PPA. Exits non-zero on timeout or build failure.
"""
import os, re, sys, time, urllib.request
from launchpadlib.launchpad import Launchpad

ppa, tag, outdir, series_list = sys.argv[1:5]
rev = sys.argv[5] if len(sys.argv) > 5 else "1"
timeout = int(os.environ.get("PPA_TIMEOUT", 3600))

version = re.sub(r"[-_]", ".", re.sub(r"[-_.]?(pre|rc|alpha|beta)", r"~\1", tag.removeprefix("v"), count=1))
owner, name = ppa.removeprefix("ppa:").split("/", 1)
lp = Launchpad.login_anonymously("cepgen-release-assets", "production", version="devel")
archive = lp.people[owner].getPPAByName(name=name)
os.makedirs(outdir, exist_ok=True)

pending = {s: f"{version}-0ppa{rev}~{s}1" for s in series_list.split()}
deadline = time.time() + timeout
while pending:
    for series, debver in list(pending.items()):
        src = archive.getPublishedSources(source_name="cepgen", version=debver, exact_match=True)
        if not len(src):
            continue
        builds = src[0].getBuilds()
        states = {b.buildstate for b in builds}
        if any(s in ("Failed to build", "Dependency wait", "Chroot problem") for s in states):
            sys.exit(f"{series}: build failed ({states})")
        if not len(builds) or states != {"Successfully built"}:
            continue
        # archive.getPublishedBinaries() has no source_name filter: ask the source publication for its own binaries
        bins = [b for b in src[0].getPublishedBinaries() if b.status == "Published"]
        if not bins:
            continue  # built, not yet published
        for b in bins:
            for url in b.binaryFileUrls():
                if url.endswith(".deb"):
                    dest = os.path.join(outdir, os.path.basename(url))
                    print(f"{series}: {url}")
                    urllib.request.urlretrieve(url, dest)
        del pending[series]
    if pending:
        if time.time() > deadline:
            sys.exit(f"timeout waiting for: {', '.join(pending)}")
        time.sleep(60)
